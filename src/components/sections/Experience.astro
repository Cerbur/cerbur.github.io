---
import { siteConfig } from "../../config/site";
import Section from "../ui/Section.astro";
import EmptyState from "../ui/EmptyState.astro";
const content = siteConfig.sections.experience;
---

<Section id="experience" title={content.title} number="02">
  {siteConfig.experience.length ? (
    <div class="space-y-6">
      {siteConfig.experience.map((experience) => (
        <article class="card">
          <p class="eyebrow muted">{experience.dateRange}</p>
          <h3 class="mt-3">{experience.title}</h3>
          <p class="accent mt-1">{experience.company}</p>
          <ul class="list-disc pl-5 space-y-2 mt-4 muted">
            {experience.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  ) : (
    <EmptyState
      title={content.emptyTitle}
      description={content.emptyDescription}
    />
  )}
</Section>
