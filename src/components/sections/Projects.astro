---
import { siteConfig, projectUrl } from "../../config/site";
import Section from "../ui/Section.astro";
import EmptyState from "../ui/EmptyState.astro";
import Arrow from "../ui/Arrow.astro";
const content = siteConfig.sections.projects;
---

<Section id="projects" title={content.title} number="03">
  {siteConfig.projects.length ? (
    <div class="space-y-5">
      {siteConfig.projects.map((project, index) => (
        <article class="card project-card">
          <p class="eyebrow accent">{String(index + 1).padStart(2, "0")}</p>
          <h3 class="mt-3">{project.name}</h3>
          <p class="muted mt-3">{project.description}</p>
          <ul
            class="flex flex-wrap gap-2 mt-5"
            aria-label="Project technologies"
          >
            {project.skills.map((skill) => (
              <li class="tag">{skill}</li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-x-6 gap-y-3 mt-6">
            <a
              class="text-link"
              href={projectUrl(project.repo)}
              aria-label={`${content.landingLabel}: ${project.name}`}
            >
              {content.landingLabel}
              <Arrow />
            </a>
            <a
              class="text-link"
              href={`${siteConfig.social.github}/${project.repo}`}
              aria-label={`${content.sourceLabel}: ${project.name}`}
            >
              {content.sourceLabel}
              <Arrow />
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <EmptyState
      title={content.emptyTitle}
      description={content.emptyDescription}
    >
      <a
        class="text-link mt-6"
        href={`${siteConfig.social.github}?tab=repositories`}
      >
        {content.browseLabel}
        <Arrow />
      </a>
    </EmptyState>
  )}
</Section>
